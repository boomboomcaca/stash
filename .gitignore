####
# Go
####

# Vendored dependencies
vendor

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# GraphQL generated output
internal/api/generated_*.go

# Generated locale files
ui/login/locales/*

####
# Visual Studio
####
/.vs

# User-specific stuff
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.vscode
.devcontainer

# Generated files
.idea/**/contentModel.xml

# Sensitive or high-churn files
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml

####
# Random
####

node_modules

*.db
*.sqlite
*.sqlite3

# Stash specific binaries and build artifacts
/stash
/stash.exe
/Stash.app
/phasher
/phasher.exe
dist
build/

# Media and cache files
/blobs/
/cache/
/tmp/
*.tmp
*.temp

# Configuration backup files
config.yml.*
*.backup

# FFmpeg binaries
/ffmpeg
/ffmpeg.exe
/ffprobe
/ffprobe.exe
ffmpeg-*
ffprobe-*
*.zip

# Log files
*.log
logs/

# OS specific files
.DS_Store
Thumbs.db
Desktop.ini

# Environment and local config
/.local*
.env
.env.local
.env.*.local

# Generated GraphQL files (keeping existing rule but adding more specific ones)
**/generated_*.go

# Plugin specific
plugins/cache/

# Test coverage
coverage.out
*.cover
