+def _clause_pauses(seg, sr, n_needed):
+    """Boundary times (sec, relative to seg start) at the END of the n_needed
+    most prominent interior pauses in the rendered clause audio, so sub-line
+    captions land on the ACTUAL clause onsets instead of a text-length estimate.
+    Returns [] (caller falls back to proportional) when it can't find clean ones."""
+    if n_needed <= 0 or sr is None or seg is None or len(seg) < int(0.30 * sr):
+        return []
+    fl = max(1, int(0.020 * sr))               # 20 ms frames
+    nf = len(seg) // fl
+    if nf < 5:
+        return []
+    seg = np.asarray(seg, dtype=np.float32)
+    rms = np.sqrt(np.array([float(np.mean(seg[i * fl:(i + 1) * fl] ** 2))
+                            for i in range(nf)]) + 1e-9)
+    thr = 0.10 * (float(np.percentile(rms, 85)) + 1e-6)
+    silent = rms < thr
+    edge = int(round(0.08 * sr))               # ignore leading/trailing silence
+    gaps = []                                  # (end_sample, length_frames)
+    i = 0
+    while i < nf:
+        if silent[i]:
+            j = i
+            while j < nf and silent[j]:
+                j += 1
+            if i * fl > edge and j * fl < len(seg) - edge and (j - i) >= 4:
+                gaps.append((j * fl, j - i))   # END of pause == next clause onset
+            i = j
+        else:
+            i += 1
+    if len(gaps) < n_needed:
+        return []
+    gaps.sort(key=lambda g: -g[1])             # most prominent pauses first
+    return sorted(s / sr for s, _ in gaps[:n_needed])
