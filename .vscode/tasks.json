{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "create-local-dir",
      "type": "shell",
      "command": "mkdir -p ${workspaceFolder}/.local",
      "windows": {
        "command": "powershell",
        "args": ["-Command", "if (!(Test-Path \"${workspaceFolder}\\.local\")) { New-Item -ItemType Directory -Path \"${workspaceFolder}\\.local\" }"]
      },
      "linux": {
        "command": "mkdir",
        "args": ["-p", "${workspaceFolder}/.local"]
      },
      "osx": {
        "command": "mkdir",
        "args": ["-p", "${workspaceFolder}/.local"]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    },
    {
      "label": "start-frontend",
      "type": "shell",
      "command": "cd ${workspaceFolder}/ui/v2.5 && yarn start --host",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE.*ready in",
          "endsPattern": "Local:.*http"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend"
      }
    },
    {
      "label": "stop-frontend",
      "type": "shell",
      "command": "kill $(lsof -t -i:5173) || true",
      "windows": {
        "command": "powershell",
        "args": ["-Command", "Get-NetTCPConnection -LocalPort 5173 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }"]
      },
      "linux": {
        "command": "bash",
        "args": ["-c", "kill $(lsof -t -i:5173) || true"]
      },
      "osx": {
        "command": "bash",
        "args": ["-c", "kill $(lsof -t -i:5173) || true"]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "close": true
      }
    }
  ]
}

