{
  "version": "0.2.0",
  // 复合调试配置
  "compounds": [
    {
      "name": "🚀 Full Stack Debug",
      "configurations": ["Backend", "Frontend"],
      "stopAll": true,
      "preLaunchTask": "create-local-dir"
    }
  ],
  // 调试配置
  "configurations": [
    // Go 后端调试
    {
      "name": "Backend",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/stash",
      "env": {
        "STASH_CONFIG_FILE": "config.yml"
      },
      "cwd": "${workspaceFolder}/.local",
      "preLaunchTask": "create-local-dir",
      "console": "integratedTerminal",
      "showLog": true
    },
    // React 前端调试 (WSL + Windows Chrome)
    {
      "name": "Frontend",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/ui/v2.5/src",
      "preLaunchTask": "start-frontend-and-chrome",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*",
        "webpack:///src/*": "${webRoot}/*",
        "webpack:///*": "*"
      }
    }
  ]
}

