{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "🚀 Full Stack Debug",
      "configurations": ["Backend", "Frontend"],
      "stopAll": true,
      "preLaunchTask": "create-local-dir",
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 1
      }
    }
  ],
  "configurations": [
    {
      "name": "Backend",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/stash",
      "env": {
        "STASH_CONFIG_FILE": "config.yml"
      },
      "cwd": "${workspaceFolder}/.local",
      "preLaunchTask": "create-local-dir",
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start",
      "cwd": "${workspaceFolder}/ui/v2.5",
      "presentation": {
        "hidden": true
      },
      "serverReadyAction": {
        "pattern": "Local:.*http://localhost:([0-9]+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}

