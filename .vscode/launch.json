{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go Backend",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/stash",
      "env": {
        "STASH_CONFIG_FILE": "config.yml"
      },
      "cwd": "${workspaceFolder}/.local",
      "preLaunchTask": "create-local-dir"
    },
    {
      "name": "React Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run start",
      "cwd": "${workspaceFolder}/ui/v2.5"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Full Stack Debug",
      "configurations": ["Go Backend", "React Frontend"],
      "stopAll": true,
      "preLaunchTask": "create-local-dir",
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 1
      }
    }
  ]
}

